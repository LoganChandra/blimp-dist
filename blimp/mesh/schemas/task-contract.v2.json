{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blimp.my/schemas/task-contract.v2.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "objective",
    "why",
    "deliverables",
    "acceptance_checks",
    "definition_of_done",
    "owner",
    "reviewer",
    "capabilities",
    "boundaries",
    "risk_tier",
    "budget",
    "effort_class"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T-\\d{4,}$"
    },
    "title": {
      "type": "string",
      "maxLength": 90
    },
    "type": {
      "enum": [
        "design",
        "research",
        "build",
        "fix",
        "ops_change",
        "incident",
        "report",
        "client_delivery",
        "sales_support",
        "maintenance",
        "learning",
        "initiative"
      ]
    },
    "objective": {
      "type": "string",
      "maxLength": 300
    },
    "why": {
      "type": "object",
      "required": [
        "rationale"
      ],
      "properties": {
        "objective_id": {
          "type": "string"
        },
        "mandate_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pr",
              "doc",
              "report",
              "config",
              "artifact",
              "decision",
              "message_draft"
            ]
          }
        }
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "test",
              "cmd",
              "http",
              "sql_readonly",
              "manual_by_logan",
              "review"
            ]
          },
          "cmd": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "procedure": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundaries": {
      "type": "object",
      "required": [
        "non_goals",
        "forbidden"
      ],
      "properties": {
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "r3_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "why"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "tokens",
        "turns"
      ],
      "properties": {
        "tokens": {
          "type": "integer"
        },
        "turns": {
          "type": "integer"
        },
        "wall_clock_h": {
          "type": "number"
        }
      }
    },
    "effort_class": {
      "enum": [
        "S",
        "M",
        "L"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string"
    },
    "comms": {
      "type": "string"
    },
    "client": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "consent_scope": {
          "type": "string"
        },
        "market": {
          "enum": [
            "SG",
            "MY",
            "OTHER"
          ]
        },
        "currency": {
          "enum": [
            "SGD",
            "MYR",
            "USD"
          ]
        }
      }
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "worktree": {
      "type": "string",
      "description": "Absolute path of the task's checkout; test/cmd checks run here (spec 10.5)"
    }
  }
}
