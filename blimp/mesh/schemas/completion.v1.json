{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blimp.my/schemas/completion.v1.json",
  "type": "object",
  "required": ["task_id","summary","claims","deliverables","checks","known_gaps","rollback"],
  "properties": {
    "task_id": {"type":"string"},
    "summary": {"type":"string","maxLength":600},
    "claims": {"type":"array","minItems":1,"items":{"type":"object","required":["text","receipts"],"properties":{"text":{"type":"string"},"receipts":{"type":"array","minItems":1,"items":{"type":"string"}}}}},
    "deliverables": {"type":"array","items":{"type":"object","required":["name","ref"],"properties":{"name":{"type":"string"},"ref":{"type":"string"}}}},
    "checks": {"type":"array","items":{"type":"object","required":["check_id","receipt","result"],"properties":{"check_id":{"type":"string"},"receipt":{"type":"string"},"result":{"enum":["pass","fail","not_run"]}}}},
    "known_gaps": {"type":"array","items":{"type":"string"}},
    "rollback": {"type":"string"},
    "lesson_candidate": {"type":"string"}
  }
}
