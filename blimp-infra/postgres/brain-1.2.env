# Env overrides for the Hindsight 1.2.0 move (2026-11-06). Set explicitly: 1.2's defaults could change
# under us, and hosted inference (provider "hindsight") is a paid service we don't use.
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=hindsight-ai/hs-rerank-1
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5
# Pinned so a recreated container picks up its own in-flight jobs instead of leaving them parked under
# the old container id (Hindsight ops docs).
HINDSIGHT_API_WORKER_ID=duke-hindsight
