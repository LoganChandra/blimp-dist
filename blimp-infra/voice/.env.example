# ── .env.example — Dual-Agent Voice Room ──────────────────────────────────────
# Copy this to .env and fill in real values. NEVER COMMIT FILLED VERSIONS.
#
# Paths:
#   /opt/blimp/voice/.env         (production — SG VM)
#   ./voice/.env                  (local dev — WSL)
#
# Required vars are marked [REQUIRED]. Everything else has a sensible default.
#
# ── LiveKit Connection ───────────────────────────────────────────────────────

# LiveKit SFU endpoint. On a droplet, internal ws://localhost:7880.
# For Cloud free tier: wss://<project>.livekit.cloud
# Must also match token_server.py's LIVEKIT_URL.
LIVEKIT_URL=ws://localhost:7880

# [REQUIRED] LiveKit API key + secret
# Self-hosted: run `livekit-server generate-keys` to create a keypair
# Cloud: from LiveKit Cloud console (https://cloud.livekit.io)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── STT: Deepgram ────────────────────────────────────────────────────────────

# [REQUIRED] Deepgram API key (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# ── LLM: Anthropic Claude (default) ──────────────────────────────────────────

# [REQUIRED] Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Claude model. Default: claude-haiku-4-5 (fast, good for voice).
# For better reasoning: claude-sonnet-4-6
LLM_MODEL=claude-haiku-4-5

# ── LLM: OpenAI (A/B path) ───────────────────────────────────────────────────
# Set LLM_PROVIDER=openai and uncomment OPENAI_API_KEY for latency A/B test.
LLM_PROVIDER=anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── TTS: Cartesia ────────────────────────────────────────────────────────────

# [REQUIRED] Cartesia API key (https://play.cartesia.ai)
CARTESIA_API_KEY=

# Cartesia TTS model. Default: sonic-2 — the model the installed
# livekit-plugins-cartesia (1.5.x) actually supports. WARNING: "sonic-3" and
# "sonic-3.5" are NOT valid for this plugin/account — Cartesia drops the stream
# and the agent connects but produces SILENCE. Verify any change against:
#   python -c "from livekit.plugins.cartesia.tts import TTSModels; print(TTSModels)"
CARTESIA_TTS_MODEL=sonic-2

# Per-persona voice IDs. agent.py swaps to the active persona's voice at
# synthesis time (custom tts_node), so Duke and Hermes can sound different.
# Must exist in / be usable by your Cartesia account — a missing id silently
# fails at speak time. List yours:
#   curl -s https://api.cartesia.ai/voices -H "X-API-Key: $CARTESIA_API_KEY" -H "Cartesia-Version: 2025-04-16"
# To use ONE shared voice, set TTS_VOICE_ID and leave the per-persona vars unset.
# Duke (he/him): deeper voice.  Hermes (she/her): warmer female voice.
TTS_VOICE_ID=
DUKE_TTS_VOICE_ID=4df027cb-2920-4a1f-8c34-f21529d5c3fe
HERMES_TTS_VOICE_ID=9626c31c-bec5-4cca-baa8-fb13faf0c4c5

# ── Behaviour ────────────────────────────────────────────────────────────────

# Greet the operator out loud the moment they join (agent talks first).
# Set to 0 to start silent and only respond after the operator speaks.
GREET_ON_JOIN=1

# Dev-only footgun: if 1, agent.py SIGTERMs sibling agent.py processes on
# startup. Leave 0 — it will also kill a parallel test/e2e run. Default 0.
KILL_STALE_AGENTS=0

# ── Room ─────────────────────────────────────────────────────────────────────

# Room name. Must match token_server.py's VOICE_ROOM_NAME.
VOICE_ROOM_NAME=blimp-voice

# ── Token Server (token_server.py) ───────────────────────────────────────────

# Port for the token server / front-end. Default 8790.
TOKEN_SERVER_PORT=8790

# Bind host. Keep 127.0.0.1 for single-user local access.
# Set 0.0.0.0 only behind a firewall / reverse proxy (Caddy).
TOKEN_SERVER_HOST=127.0.0.1

# Optional: public WSS URL for browser clients. When the agent connects via
# ws://localhost:7880 internally, the browser needs the public wss:// address.
# Example: wss://voice.blimp.so
# If unset, browsers get LIVEKIT_URL (ws://localhost:7880 won't work remotely).
# PUBLIC_LIVEKIT_URL=wss://voice.blimp.so

# Token TTL in minutes. Short-lived for single-session use. Default 60.
TOKEN_TTL_MINUTES=60