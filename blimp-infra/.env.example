# =============================================================================
# .env.example — environment template for the Blimp two-agent stack.
#
# COPY THIS FILE to ~/blimp/.env (for Duke + shared infra) and a SUBSET into
# ~/.hermes/.env (for Hermes — see notes below). NEVER COMMIT FILLED VERSIONS.
#
# scripts/restore-from-repo.sh prompts for these on fresh installs; this
# file is the reference of what's needed and where.
# =============================================================================

# ─── Shared (used by Duke + Hermes + Hindsight) ─────────────────────────────
# OpenRouter API key — powers both Hermes's LLM and Hindsight's memory ops.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ─── Hindsight (memory layer) ────────────────────────────────────────────────
# WHICH model Hindsight uses for fact-extraction + consolidation.
# Default is gpt-oss-20b:nitro (fast, cheap, open-source via OpenRouter).
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_BASE_URL=https://openrouter.ai/api/v1
HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b:nitro

# ─── Hermes model (LLM Hermes himself runs on) ──────────────────────────────
# Informational — actual setting lives in ~/.hermes/config.yaml's model.default.
# This var lets the bootstrap pick a default during fresh install.
HERMES_DUKE_MODEL=qwen/qwen3-max

# ─── Discord bot tokens ──────────────────────────────────────────────────────
# YOU NEED TWO SEPARATE DISCORD APPLICATIONS — one for Duke, one for Hermes.
#   Create both at https://discord.com/developers/applications:
#     1. New Application → name it "Duke" or "Hermes"
#     2. Bot tab → Reset Token → copy
#     3. Enable intents: Server Members + Message Content
#     4. OAuth2 URL Generator → scopes: bot + applications.commands
#        Permissions: View Channels, Send Messages, Read Message History,
#        Embed Links, Attach Files, Add Reactions, Use Slash Commands
#     5. Invite via the generated URL to your Blimp server
#
# DUKE's token goes in    ~/blimp/.env       (this file's location for Duke)
DISCORD_BOT_TOKEN=MTUw...DUKE_TOKEN_HERE...XXXX
#
# HERMES's token goes in  ~/.hermes/.env     (separate file for Hermes)
# (Hermes only needs: DISCORD_BOT_TOKEN, OPENROUTER_API_KEY,
#  DISCORD_ALLOWED_USERS, DISCORD_HOME_CHANNEL, DISCORD_ALLOWED_CHANNELS,
#  DISCORD_FREE_RESPONSE_CHANNELS, plus optional LLM keys.)

# ─── Discord server + user IDs ───────────────────────────────────────────────
# Enable Developer Mode in Discord settings, right-click → Copy ID.
DISCORD_GUILD_ID=<ID>             # Your Blimp Discord server ID
DISCORD_OWNER_USER_ID=YOUR_DISCORD_USER_ID       # Your personal user ID

# ─── Discord channel routing ─────────────────────────────────────────────────
# Channel IDs for each agent's primary channel. Hermes uses these for routing
# (responds without @mention in his channel). Duke uses pairing flow instead
# but it's useful to record them.
DUKE_CHANNEL_ID=<ID>              # #🎩-duke
HERMES_CHANNEL_ID=<ID>            # #🪽-hermes

# These three are HERMES-ONLY (set in ~/.hermes/.env). Drop them in here too
# for reference / restore script consumption.
DISCORD_ALLOWED_USERS=YOUR_DISCORD_USER_ID       # Whitelist (same as OWNER_USER_ID)
DISCORD_HOME_CHANNEL=<ID>         # Hermes posts cron etc. here
DISCORD_ALLOWED_CHANNELS=<ID>     # Restrict Hermes to this + DMs
DISCORD_FREE_RESPONSE_CHANNELS=<ID>  # No @mention required

# ─── Paths (auto-set by bootstrap; rarely needs manual edit) ────────────────
BLIMP_HOME=/home/$USER/blimp
PROJECT_NAME=blimp
WORKSPACE=$HOME/blimp/repo
REPO=$HOME/blimp/repo
TMUX_SESSION=duke

# ─── Optional: extra LLM provider keys (Hermes can route to them) ───────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ─── Optional: tool API keys (web search etc.) ──────────────────────────────
# EXA_API_KEY=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# XAI_API_KEY=

# ─── Hermes runtime tuning (rarely needs change) ────────────────────────────
# TERMINAL_TIMEOUT=120
# BROWSER_SESSION_TIMEOUT=600
